//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   if((_Symbol != "XAUUSD" && _Symbol != "BTCUSD") || _Period != PERIOD_M1)
   {
      Alert("EA is designed for XAUUSD or BTCUSD on M1 only!");
      return(INIT_FAILED);
   }

   if(StringLen(OpenRouterAPIKey) < 10)
   {
      Alert("Please enter a valid OpenRouter API key!");
      return(INIT_FAILED);
   }

   if(NumAIs < 1 || NumAIs > 5)
   {
      Alert("NumAIs must be between 1 and 5");
      return(INIT_FAILED);
   }

   selectedModelNames = UseFreeModels ? FreeModelNames : PaidModelNames;
   Print("Model Selection: ", UseFreeModels ? "Free Models" : "Paid Models", " - ", selectedModelNames);

   atrHandle = iATR(_Symbol, _Period, ATRPeriod);
   bbHandle = iBands(_Symbol, _Period, BBPeriod, 0, BBDeviation, PRICE_CLOSE);
   maHandle = iMA(_Symbol, _Period, TrendMAPeriod, 0, MODE_SMA, PRICE_CLOSE);
   if(atrHandle == INVALID_HANDLE || bbHandle == INVALID_HANDLE || maHandle == INVALID_HANDLE)
   {
      Alert("Failed to create indicator handles");
      return(INIT_FAILED);
   }

   ArraySetAsSeries(atrBuffer, true);
   ArrayInitialize(spreadHistory, 0.0);

   Print("Enhanced AI Scalper EA v3.10 initialized successfully on ", _Symbol, " using ", UseFreeModels ? "FREE" : "PAID", " models");
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   if(atrHandle != INVALID_HANDLE)
      IndicatorRelease(atrHandle);
   if(bbHandle != INVALID_HANDLE)
      IndicatorRelease(bbHandle);
   if(maHandle != INVALID_HANDLE)
      IndicatorRelease(maHandle);

   Comment("");
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   datetime currentBarTime = iTime(_Symbol, _Period, 0);
   if(currentBarTime == lastBarTime)
   {
      ManagePositions();
      UpdateDashboard();
      return;
   }
   lastBarTime = currentBarTime;

   ManagePositions();

   if(TradeOnlyOnePosition && HasOpenPositionOnSymbol())
   {
      UpdateDashboard();
      return;
   }

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double pipSize = CalculatePipSize();
   if(pipSize <= 0)
      pipSize = _Point;

   //--- Spread tracking
   double currentSpreadPoints = (ask - bid) / _Point;
   int arraySize = ArraySize(spreadHistory);
   if(arraySize > 0)
   {
      spreadHistory[spreadIndex % arraySize] = currentSpreadPoints;
      spreadIndex++;
   }

   double avgSpreadPoints = CalculateAvgSpread(AvgSpreadPeriod);
   double maxAllowedSpreadPoints = MaxSpreadPips * (pipSize / _Point);
   bool spreadOK = (avgSpreadPoints <= maxAllowedSpreadPoints);

   ENUM_TREND_MODE currentTrend = GetTrend();
   bool trendOK = !EnableTrendFilter;

   ENUM_TREND_MODE signalTrend = TREND_SIDEWAYS;
   ENUM_VOLATILITY_LEVEL volLevel = GetVolatilityLevel();
   bool volOK = IsVolatilityOK();
   bool volLevelOK = true;
   if(VolLevel == VOL_MEDIUM)
      volLevelOK = (volLevel == VOL_MEDIUM || volLevel == VOL_HIGH);
   else if(VolLevel == VOL_HIGH)
      volLevelOK = (volLevel == VOL_HIGH);

   string prompt = PreparePrompt();
   if(StringFind(prompt, "Error") == 0)
   {
      Print("Prompt preparation failed: ", prompt);
      UpdateDashboard();
      return;
   }

   AI_Decision decisions[];
   GetMultiAIDecisions(prompt, decisions, selectedModelNames);
   if(ArraySize(decisions) == 0)
   {
      Print("No AI decisions retrieved");
      UpdateDashboard();
      return;
   }

   string finalDecision = VoteDecisions(decisions);
   bool isHold = (finalDecision == "HOLD");
   double avgConfidence = 0.0;
   for(int i = 0; i < ArraySize(decisions); i++)
      avgConfidence += decisions[i].confidence;
   avgConfidence /= ArraySize(decisions);

   lastAdvice = finalDecision;
   lastConfidence = avgConfidence;

   double entryPrice = 0.0;
   ENUM_ORDER_TYPE orderType = ORDER_TYPE_BUY;
   double finalSL = 0.0;
   double finalTP = 0.0;
   double lotSize = 0.0;

   if(!isHold)
   {
      bool isBuy = (finalDecision == "BUY");
      orderType = isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
      entryPrice = isBuy ? ask : bid;
      signalTrend = isBuy ? TREND_UP : TREND_DOWN;
      trendOK = !EnableTrendFilter || currentTrend == signalTrend;

      ApplyAIBasedSLTP(finalDecision, decisions, UseWeightedSLTP, finalSL, finalTP);
      EnforceSLTPValidity(isBuy, entryPrice, finalSL, finalTP);

      if(AddTPMode != ADD_TP_NONE && TPMode != MODE_AI_REC)
         finalTP = CalculateAdditionalTP(isBuy);

      double altSL = finalSL;
      double altTP = finalTP;
      CalculateAdaptiveSLTP(isBuy, finalSL, finalTP, altSL, altTP);
      finalSL = altSL;
      finalTP = altTP;

      lotSize = CalculateDynamicLot(finalSL);
      lotSize *= LotValue;
      lotSize = NormalizeDouble(lotSize, 2);
   }

   bool tradeOK = !isHold && spreadOK && volOK && volLevelOK && trendOK && lotSize > 0;
   if(tradeOK)
   {
      PrintFormat("EXECUTING TRADE: %s | Confidence: %.1f%% | Entry: %.5f | SL: %.5f | TP: %.5f | Lot: %.2f",
                  finalDecision, avgConfidence * 100.0, entryPrice, finalSL, finalTP, lotSize);
      OpenTrade(orderType, lotSize, finalSL, finalTP);
   }
   else
   {
      string message = isHold ? "HOLD SIGNAL" : "REJECTED SIGNAL";
      PrintFormat("%s: %s | Confidence: %.1f%%", message, finalDecision, avgConfidence * 100.0);
      if(!isHold)
      {
         string reasons = "";
         if(!spreadOK) reasons += "High Spread; ";
         if(!volOK) reasons += "Volatility Gate; ";
         if(!volLevelOK) reasons += "Volatility Level Filter; ";
         if(!trendOK) reasons += "Trend Filter; ";
         if(lotSize <= 0) reasons += "Invalid Lot; ";
         if(StringLen(reasons) > 0)
            Print("Rejection Reasons: ", reasons);
      }
   }

   UpdateDashboard();
}

//+------------------------------------------------------------------+
//| Manage open positions: Trailing and Breakeven                     |
//+------------------------------------------------------------------+
void ManagePositions()
{
   double pipSize = CalculatePipSize();
   if(pipSize <= 0)
      pipSize = _Point;

    int totalPositions = PositionsTotal();
    for(int i = totalPositions - 1; i >= 0; i--)
   {
      if(!PositionSelectByIndex(i))
         continue;

      string posSymbol = PositionGetString(POSITION_SYMBOL);
      if(posSymbol != _Symbol)
         continue;

      long posMagic = PositionGetInteger(POSITION_MAGIC);
      if(posMagic != MagicNumber)
         continue;

      ulong ticket = PositionGetInteger(POSITION_TICKET);
      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double currentSL = PositionGetDouble(POSITION_SL);
      double currentTP = PositionGetDouble(POSITION_TP);
      ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      bool isBuy = (posType == POSITION_TYPE_BUY);
      double currentPrice = isBuy ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);

      double profitPips = isBuy ? (currentPrice - openPrice) / pipSize : (openPrice - currentPrice) / pipSize;

      if(BreakevenMode != BE_OFF)
      {
         double trigger = BreakevenTrigger;
         if(BreakevenMode == BE_PERCENT)
            trigger = (BreakevenTrigger / 100.0) * (openPrice / pipSize);

         if(profitPips >= trigger)
         {
            if(MathAbs(currentSL - openPrice) > (_Point * 0.1))
            {
               ModifyPosition(ticket, openPrice, currentTP);
               Print("Breakeven triggered for ticket ", ticket);
            }
         }
      }

      if(TrailingMode != TRAIL_OFF)
      {
         double trailStart = TrailingStart;
         double trailStop = TrailingStop;
         double trailStep = TrailingStep;

         if(TrailingMode == TRAIL_PERCENT)
         {
            trailStart = (TrailingStart / 100.0) * (openPrice / pipSize);
            trailStop  = (TrailingStop / 100.0) * (openPrice / pipSize);
            trailStep  = (TrailingStep / 100.0) * (openPrice / pipSize);
         }

         if(profitPips >= trailStart)
         {
            double desiredSL = isBuy ? currentPrice - trailStop * pipSize : currentPrice + trailStop * pipSize;
            bool shouldUpdate = isBuy ? (desiredSL > currentSL + trailStep * pipSize) : (desiredSL < currentSL - trailStep * pipSize);
            if(shouldUpdate)
            {
               ModifyPosition(ticket, desiredSL, currentTP);
            }
         }
      }
   }
}

