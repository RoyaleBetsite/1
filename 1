//+------------------------------------------------------------------+
//| Helper: determine pip size                                        |
//+------------------------------------------------------------------+
double CalculatePipSize()
{
   if(_Symbol == "XAUUSD")
      return 0.1;
   if(_Symbol == "BTCUSD")
      return 0.01;

   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   if(digits <= 3)
      return 0.1;
   if(digits == 4)
      return 0.001;
   return _Point * 10.0;
}

//+------------------------------------------------------------------+
//| Helper: determine if there is an open position on symbol          |
//+------------------------------------------------------------------+
bool HasOpenPositionOnSymbol()
{
    int totalPositions = PositionsTotal();
    for(int i = 0; i < totalPositions; i++)
   {
      if(!PositionSelectByIndex(i))
         continue;
      if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == MagicNumber)
         return true;
   }
   return false;
}

//+------------------------------------------------------------------+
//| Trend calculation using moving average                            |
//+------------------------------------------------------------------+
ENUM_TREND_MODE GetTrend()
{
   double maBuffer[2];
   if(CopyBuffer(maHandle, 0, 0, 2, maBuffer) != 2)
      return TREND_SIDEWAYS;

   double lastClose = iClose(_Symbol, _Period, 0);
   if(lastClose > maBuffer[0] && maBuffer[0] > maBuffer[1])
      return TREND_UP;
   if(lastClose < maBuffer[0] && maBuffer[0] < maBuffer[1])
      return TREND_DOWN;
   return TREND_SIDEWAYS;
}

//+------------------------------------------------------------------+
//| Volatility level based on ATR                                     |
//+------------------------------------------------------------------+
ENUM_VOLATILITY_LEVEL GetVolatilityLevel()
{
   if(CopyBuffer(atrHandle, 0, 0, 1, atrBuffer) != 1)
      return VOL_MEDIUM;

   double pipSize = CalculatePipSize();
   if(pipSize <= 0)
      pipSize = _Point;

   double atrPips = atrBuffer[0] / pipSize;
   if(atrPips < 5.0)
      return VOL_LOW;
   if(atrPips < 15.0)
      return VOL_MEDIUM;
   return VOL_HIGH;
}

//+------------------------------------------------------------------+
//| Volatility gate (ATR + Bollinger Band width)                      |
//+------------------------------------------------------------------+
bool IsVolatilityOK()
{
   if(CopyBuffer(atrHandle, 0, 0, 1, atrBuffer) != 1)
      return false;

   double atrValue = atrBuffer[0];
   if(atrValue < MinVolatility || atrValue > MaxVolatility)
      return false;

   double bbUpper[1], bbLower[1], bbMiddle[1];

   if(CopyBuffer(bbHandle, 1, 0, 1, bbUpper) != 1 ||
      CopyBuffer(bbHandle, 2, 0, 1, bbLower) != 1 ||
      CopyBuffer(bbHandle, 0, 0, 1, bbMiddle) != 1)
      return false;

   double bbWidth = bbUpper[0] - bbLower[0];
   if(bbWidth < BBMinWidth || bbWidth > BBMaxWidth)
      return false;

   return true;
}

//+------------------------------------------------------------------+
//| Prepare prompt for AI models                                      |
//+------------------------------------------------------------------+
string PreparePrompt()
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double pipSize = CalculatePipSize();
   if(pipSize <= 0)
      pipSize = _Point;

   double spreadPips = (ask - bid) / pipSize;
   if(CopyBuffer(atrHandle, 0, 0, 1, atrBuffer) != 1)
      return "Error: Unable to copy ATR";

   double atrPips = atrBuffer[0] / pipSize;

   string prompt = "You are a high-frequency scalping AI for " + _Symbol + " on the 1-minute timeframe. ";
   prompt += "Goal: execute low-drawdown, quick trades. Respond with BUY, SELL, or HOLD with confidence (0-1). ";
   prompt += "For BUY/SELL supply absolute SL/TP prices (e.g. SL=2350.50 TP=2352.10). ";
   prompt += "Current spread: " + DoubleToString(spreadPips, 1) + " pips. ";
   prompt += "ATR: " + DoubleToString(atrPips, 1) + " pips. ";
   prompt += "Bid: " + DoubleToString(bid, _Digits) + " | Ask: " + DoubleToString(ask, _Digits) + ". ";
   prompt += "Recent " + IntegerToString(BarsToSend) + " bars (newest first) follow as OHLC:\n";

   double open[], high[], low[], close[];
   ArraySetAsSeries(open, true);
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);

   if(CopyOpen(_Symbol, _Period, 0, BarsToSend, open) != BarsToSend ||
      CopyHigh(_Symbol, _Period, 0, BarsToSend, high) != BarsToSend ||
      CopyLow(_Symbol, _Period, 0, BarsToSend, low) != BarsToSend ||
      CopyClose(_Symbol, _Period, 0, BarsToSend, close) != BarsToSend)
      return "Error: Unable to fetch bar data";

   for(int i = 0; i < BarsToSend; ++i)
   {
      prompt += StringFormat("Bar %02d: O=%.5f H=%.5f L=%.5f C=%.5f\n", i + 1, open[i], high[i], low[i], close[i]);
   }

   prompt += "Respond ONLY with: ACTION:BUY|CONFIDENCE:0.XX|SL:XXXX.XX|TP:XXXX.XX or ACTION:HOLD|CONFIDENCE:0.XX. Do not add commentary.";
   return prompt;
}

//+------------------------------------------------------------------+
//| Retrieve AI decisions for multiple models                         |
//+------------------------------------------------------------------+
void GetMultiAIDecisions(const string prompt, AI_Decision &decisions[], const string modelList)
{
   ArrayResize(decisions, NumAIs);
   for(int i = 0; i < NumAIs; ++i)
   {
      decisions[i].action = "HOLD";
      decisions[i].confidence = 0.0;
      decisions[i].slPrice = 0.0;
      decisions[i].tpPrice = 0.0;
   }

   string models[];
   int totalModels = StringSplit(modelList, ';', models);
   if(totalModels <= 0)
      return;

   int limit = MathMin(NumAIs, totalModels);
   for(int i = 0; i < limit; ++i)
   {
      string model = models[i];
      StringTrimLeft(model);
      StringTrimRight(model);
      string decisionString = GetAIDecision(prompt, model);
      ParseAIDecision(decisionString, decisions[i]);
   }
}

//+------------------------------------------------------------------+
//| Perform a single AI request                                       |
//+------------------------------------------------------------------+
string GetAIDecision(const string prompt, const string modelName)
{
   string headers = "Content-Type: application/json\r\nAuthorization: Bearer " + OpenRouterAPIKey + "\r\n";
   string body = "{" +
                 "\"model\":\"" + modelName + "\"," +
                 "\"messages\":[{\"role\":\"user\",\"content\":\"" + prompt + "\"}]," +
                 "\"max_tokens\":120," +
                 "\"temperature\":0.1" +
                 "}";

   char postData[];
   StringToCharArray(body, postData, 0, WHOLE_ARRAY, CP_UTF8);

   char result[];
   string resultHeaders;
   int status = WebRequest("POST", openRouterURL, headers, NULL, 10000, postData, ArraySize(postData), result, resultHeaders);

   if(status != 200)
   {
      Print("API call failed for ", modelName, " | HTTP ", status, " | Headers: ", resultHeaders);
      return "ACTION:HOLD|CONFIDENCE:0.0";
   }

   string response = CharArrayToString(result);
   Print("API Response for ", modelName, ": ", response);

   string contentMarker = "\"content\":";
   int start = StringFind(response, contentMarker);
   if(start == -1)
      return "ACTION:HOLD|CONFIDENCE:0.0";

   start = StringFind(response, "\"", start + StringLen(contentMarker));
   if(start == -1)
      return "ACTION:HOLD|CONFIDENCE:0.0";
   start++;

   int end = start;
   while(true)
   {
      int nextQuote = StringFind(response, "\"", end);
      if(nextQuote == -1)
         break;

      int backslashCount = 0;
      for(int j = nextQuote - 1; j >= start && StringGetCharacter(response, j) == 92; --j)
         backslashCount++;

      if((backslashCount % 2) == 0)
      {
         end = nextQuote;
         break;
      }
      end = nextQuote + 1;
   }

   string rawContent = StringSubstr(response, start, end - start);
   StringReplace(rawContent, "\\n", "\n");
   StringReplace(rawContent, "\\r", "");
   StringReplace(rawContent, "\\\"", "\"");
   StringTrimLeft(rawContent);
   StringTrimRight(rawContent);

   return rawContent;
}

//+------------------------------------------------------------------+
//| Parse AI decision string                                          |
//+------------------------------------------------------------------+
void ParseAIDecision(const string decStr, AI_Decision &dec)
{
   dec.action = "HOLD";
   dec.confidence = 0.0;
   dec.slPrice = 0.0;
   dec.tpPrice = 0.0;

   if(StringLen(decStr) == 0)
      return;

   Print("Parsing AI decision: ", decStr);

   int actionPos = StringFind(decStr, "ACTION:");
   if(actionPos == -1)
      return;

   int actionEnd = StringFind(decStr, "|", actionPos);
   if(actionEnd == -1)
      actionEnd = StringLen(decStr);

   string actionPart = StringSubstr(decStr, actionPos + 7, actionEnd - actionPos - 7);
   StringTrimLeft(actionPart);
   StringTrimRight(actionPart);
   StringToUpper(actionPart);

   if(StringFind(actionPart, "BUY") != -1)
      dec.action = "BUY";
   else if(StringFind(actionPart, "SELL") != -1)
      dec.action = "SELL";
   else
      dec.action = "HOLD";

   int confPos = StringFind(decStr, "CONFIDENCE:", actionEnd);
   if(confPos != -1)
   {
      int confEnd = StringFind(decStr, "|", confPos + 1);
      if(confEnd == -1)
         confEnd = StringLen(decStr);
      string confPart = StringSubstr(decStr, confPos + 10, confEnd - confPos - 10);
      StringReplace(confPart, ":", " ");
      StringTrimLeft(confPart);
      StringTrimRight(confPart);
      double value = StringToDouble(confPart);
      dec.confidence = MathMax(0.0, MathMin(1.0, value));
   }

   if(dec.action == "HOLD")
      return;

   int slPos = StringFind(decStr, "SL:");
   if(slPos != -1)
   {
      string slPart = decStr;
      slPart = StringSubstr(slPart, slPos + 3);
      int slEnd = StringFind(slPart, "|");
      if(slEnd != -1)
         slPart = StringSubstr(slPart, 0, slEnd);
      StringTrimLeft(slPart);
      StringTrimRight(slPart);

      for(int i = 0; i < StringLen(slPart); ++i)
      {
         int ch = StringGetCharacter(slPart, i);
         if(!(ch == '.' || ch == '-' || (ch >= '0' && ch <= '9')))
            StringSetCharacter(slPart, i, ' ');
      }
      StringTrimLeft(slPart);
      StringTrimRight(slPart);
      dec.slPrice = StringToDouble(slPart);
   }

   int tpPos = StringFind(decStr, "TP:");
   if(tpPos != -1)
   {
      string tpPart = decStr;
      tpPart = StringSubstr(tpPart, tpPos + 3);
      int tpEnd = StringFind(tpPart, "|");
      if(tpEnd != -1)
         tpPart = StringSubstr(tpPart, 0, tpEnd);
      StringTrimLeft(tpPart);
      StringTrimRight(tpPart);

      for(int i = 0; i < StringLen(tpPart); ++i)
      {
         int ch = StringGetCharacter(tpPart, i);
         if(!(ch == '.' || ch == '-' || (ch >= '0' && ch <= '9')))
            StringSetCharacter(tpPart, i, ' ');
      }
      StringTrimLeft(tpPart);
      StringTrimRight(tpPart);
      dec.tpPrice = StringToDouble(tpPart);
   }

   PrintFormat("Parsed result -> Action: %s | Confidence: %.2f | SL: %.5f | TP: %.5f",
               dec.action,
               dec.confidence,
               dec.slPrice,
               dec.tpPrice);
}

//+------------------------------------------------------------------+
//| Voting logic                                                      |
//+------------------------------------------------------------------+
string VoteDecisions(AI_Decision &decisions[])
{
   int total = ArraySize(decisions);
   if(total <= 0)
      return "HOLD";

   int buyCount = 0;
   int sellCount = 0;
   double avgConf = 0.0;

   for(int i = 0; i < total; ++i)
   {
      if(decisions[i].action == "BUY")
         buyCount++;
      else if(decisions[i].action == "SELL")
         sellCount++;
      avgConf += decisions[i].confidence;
   }

   avgConf /= total;
   PrintFormat("AI Votes -> BUY: %d | SELL: %d | Avg Confidence: %.1f%%", buyCount, sellCount, avgConf * 100.0);

   if(avgConf < MinConfidence)
   {
      PrintFormat("Average confidence %.1f%% below minimum %.1f%%", avgConf * 100.0, MinConfidence * 100.0);
      return "HOLD";
   }

   double buyRatio = (double)buyCount / total;
   double sellRatio = (double)sellCount / total;

   switch(VoteMode)
   {
      case VOTE_MAJORITY:
         if(buyRatio > sellRatio && buyRatio > 0.5)
            return "BUY";
         if(sellRatio > buyRatio && sellRatio > 0.5)
            return "SELL";
         break;
      case VOTE_UNANIMOUS:
         if(buyCount == total)
            return "BUY";
         if(sellCount == total)
            return "SELL";
         break;
      case VOTE_THRESHOLD:
         if(buyRatio >= VoteThreshold)
            return "BUY";
         if(sellRatio >= VoteThreshold)
            return "SELL";
         break;
   }

   Print("Voting result: HOLD (no clear decision)");
   return "HOLD";
}

//+------------------------------------------------------------------+
//| Apply AI-based SL/TP weighting                                    |
//+------------------------------------------------------------------+
void ApplyAIBasedSLTP(const string decision, AI_Decision &decisions[], const bool useWeighted, double &sl, double &tp)
{
   sl = 0.0;
   tp = 0.0;

   bool isBuy = (decision == "BUY");
   double weightedSumSL = 0.0;
   double weightedSumTP = 0.0;
   double sumConf = 0.0;
   double bestConf = -1.0;
   double bestSL = 0.0;
   double bestTP = 0.0;

   for(int i = 0; i < ArraySize(decisions); ++i)
   {
      if(decisions[i].action != decision)
         continue;

      double conf = MathMax(0.0, decisions[i].confidence);
      if(conf <= 0.0)
         continue;

      weightedSumSL += decisions[i].slPrice * conf;
      weightedSumTP += decisions[i].tpPrice * conf;
      sumConf += conf;

      if(conf > bestConf)
      {
         bestConf = conf;
         bestSL = decisions[i].slPrice;
         bestTP = decisions[i].tpPrice;
      }
   }

   if(sumConf > 0.0)
   {
      if(useWeighted)
      {
         sl = weightedSumSL / sumConf;
         tp = weightedSumTP / sumConf;
      }
      else
      {
         sl = bestSL;
         tp = bestTP;
      }
   }
   else
   {
      CalculateFallbackSLTP(isBuy, sl, tp);
   }
}

//+------------------------------------------------------------------+
//| Ensure SL/TP are valid relative to entry                          |
//+------------------------------------------------------------------+
void EnforceSLTPValidity(const bool isBuy, const double entryPrice, double &sl, double &tp)
{
   double pipSize = CalculatePipSize();
   if(pipSize <= 0)
      pipSize = _Point;

   double minGap = SLTPFallbackBuffer * pipSize;

   if(sl <= 0.0 || tp <= 0.0)
   {
      CalculateFallbackSLTP(isBuy, sl, tp);
      return;
   }

   if(isBuy)
   {
      if(sl >= entryPrice - minGap)
         sl = entryPrice - (FixedSLPips * pipSize);
      if(tp <= entryPrice + minGap)
         tp = entryPrice + (FixedTPPips * pipSize);
   }
   else
   {
      if(sl <= entryPrice + minGap)
         sl = entryPrice + (FixedSLPips * pipSize);
      if(tp >= entryPrice - minGap)
         tp = entryPrice - (FixedTPPips * pipSize);
   }
}

//+------------------------------------------------------------------+
//| Fallback SL/TP                                                    |
//+------------------------------------------------------------------+
void CalculateFallbackSLTP(const bool isBuy, double &sl, double &tp)
{
   double pipSize = CalculatePipSize();
   if(pipSize <= 0)
      pipSize = _Point;

   double price = isBuy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   sl = isBuy ? price - FixedSLPips * pipSize : price + FixedSLPips * pipSize;
   tp = isBuy ? price + FixedTPPips * pipSize : price - FixedTPPips * pipSize;
}

//+------------------------------------------------------------------+
//| Adaptive SL/TP modes (non-AI)                                     |
//+------------------------------------------------------------------+
void CalculateAdaptiveSLTP(const bool isBuy, const double aiSL, const double aiTP, double &sl, double &tp)
{
   double price = isBuy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double pipSize = CalculatePipSize();
   if(pipSize <= 0)
      pipSize = _Point;

   double atrValue = 0.0;
   if(CopyBuffer(atrHandle, 0, 0, 1, atrBuffer) == 1)
      atrValue = atrBuffer[0];

   switch(SLMode)
   {
      case MODE_FIXED_PIPS:
         sl = isBuy ? price - FixedSLPips * pipSize : price + FixedSLPips * pipSize;
         break;
      case MODE_PERCENTAGE:
         {
            double distance = price * (PercentRisk / 100.0);
            sl = isBuy ? price - distance : price + distance;
         }
         break;
      case MODE_ATR_SWING:
         sl = isBuy ? price - ATRMultiplierSL * atrValue : price + ATRMultiplierSL * atrValue;
         break;
      case MODE_AI_REC:
         sl = aiSL;
         break;
      default:
         sl = isBuy ? price - FixedSLPips * pipSize : price + FixedSLPips * pipSize;
   }

   switch(TPMode)
   {
      case MODE_FIXED_PIPS:
         tp = isBuy ? price + FixedTPPips * pipSize : price - FixedTPPips * pipSize;
         break;
      case MODE_PERCENTAGE:
         {
            double distance = price * (PercentRisk / 100.0) * 1.5;
            tp = isBuy ? price + distance : price - distance;
         }
         break;
      case MODE_ATR_SWING:
         tp = isBuy ? price + ATRMultiplierTP * atrValue : price - ATRMultiplierTP * atrValue;
         break;
      case MODE_AI_REC:
         tp = aiTP;
         break;
      default:
         tp = isBuy ? price + FixedTPPips * pipSize : price - FixedTPPips * pipSize;
   }
}

//+------------------------------------------------------------------+
//| Additional take profit based on higher timeframe                   |
//+------------------------------------------------------------------+
double CalculateAdditionalTP(const bool isBuy)
{
   ENUM_TIMEFRAMES tf = (AddTPMode == ADD_TP_H1) ? PERIOD_H1 : PERIOD_H4;
   double tfClose = iClose(_Symbol, tf, 0);
   double currentPrice = isBuy ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double direction = isBuy ? 1.0 : -1.0;
   return currentPrice + direction * (tfClose - currentPrice) * 1.5;
}

//+------------------------------------------------------------------+
//| Calculate average spread in points                                |
//+------------------------------------------------------------------+
double CalculateAvgSpread(int period)
{
   int size = ArraySize(spreadHistory);
   if(size == 0 || spreadIndex == 0)
      return 0.0;

   int effective = MathMin(period, MathMin(spreadIndex, size));
   if(effective <= 0)
      return 0.0;

   double sum = 0.0;
   for(int i = 0; i < effective; ++i)
   {
      int idx = (spreadIndex - 1 - i) % size;
      if(idx < 0)
         idx += size;
      sum += spreadHistory[idx];
   }

   return sum / effective;
}

//+------------------------------------------------------------------+
//| Dynamic lot calculation                                           |
//+------------------------------------------------------------------+
double CalculateDynamicLot(const double slPrice)
{
   double balance   = AccountInfoDouble(ACCOUNT_BALANCE);
   double price     = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tickSize <= 0.0)
      tickSize = _Point;

   double slDistancePoints = MathAbs(price - slPrice) / tickSize;
   if(slDistancePoints <= 0.0)
      slDistancePoints = 1.0;

   double riskPct = (DynamicRiskPercent > 0.0) ? DynamicRiskPercent : RiskPercent;

   switch(LotMode)
   {
      case LOT_FIXED:
         return LotSize;
      case LOT_RISK_BASED:
         {
            double riskAmount = balance * (riskPct / 100.0);
            if(tickValue == 0.0)
               tickValue = 1.0;
            double lot = riskAmount / (slDistancePoints * tickValue);
            double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
            double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
            double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
            if(stepLot == 0.0)
               stepLot = 0.01;
            lot = MathMax(minLot, MathMin(maxLot, NormalizeDouble(lot / stepLot, 0) * stepLot));
            return lot;
         }
      case LOT_PERCENT_BALANCE:
         {
            double contractSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_CONTRACT_SIZE);
            if(contractSize == 0.0 || price == 0.0)
               return LotSize;
            double exposure = balance * (BalancePercent / 100.0);
            double lot = exposure / (contractSize * price);
            double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
            double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
            double stepLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
            if(stepLot == 0.0)
               stepLot = 0.01;
            lot = MathMax(minLot, MathMin(maxLot, NormalizeDouble(lot / stepLot, 0) * stepLot));
            return lot;
         }
      default:
         return LotSize;
   }
}
//+------------------------------------------------------------------+
//| Open a market order                                               |
//+------------------------------------------------------------------+
void OpenTrade(const ENUM_ORDER_TYPE orderType, double lot, double sl, double tp)
{
   double price = (orderType == ORDER_TYPE_BUY) ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double volumeStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double volumeMin  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double volumeMax  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   if(volumeStep <= 0.0)
      volumeStep = 0.01;

   lot = MathMax(volumeMin, MathMin(volumeMax, NormalizeDouble(lot / volumeStep, 0) * volumeStep));

   MqlTradeRequest request;
   MqlTradeResult result;
   ZeroMemory(request);
   ZeroMemory(result);

   request.action = TRADE_ACTION_DEAL;
   request.symbol = _Symbol;
   request.volume = lot;
   request.type = orderType;
   request.price = price;
   request.sl = sl;
   request.tp = tp;
   request.magic = MagicNumber;
   request.deviation = 3;
   request.type_filling = ORDER_FILLING_IOC;

   if(!OrderSend(request, result))
   {
      Print("Trade failed: ", result.retcode, " | ", result.comment);
      return;
   }

   Print("Trade opened: ", OrderTypeToString(orderType), " Lot=", DoubleToString(lot, 2), " SL=", DoubleToString(sl, _Digits), " TP=", DoubleToString(tp, _Digits));
}

//+------------------------------------------------------------------+
//| Modify SL/TP for an open position                                 |
//+------------------------------------------------------------------+
void ModifyPosition(const ulong ticket, const double newSL, const double newTP)
{
   MqlTradeRequest request;
   MqlTradeResult result;
   ZeroMemory(request);
   ZeroMemory(result);

   request.action = TRADE_ACTION_SLTP;
   request.position = ticket;
   request.symbol = _Symbol;
   request.sl = newSL;
   request.tp = newTP;

   if(!OrderSend(request, result))
      Print("Modify failed: ", result.retcode, " | ", result.comment);
   else
      Print("Position modified: SL=", DoubleToString(newSL, _Digits), " TP=", DoubleToString(newTP, _Digits));
}

